# 复制为仓库根目录 .env.production 后填写；不要提交真实凭据。
API_PORT=8000
# 服务器部署填写 Actions 发布的完整提交 SHA 标签，避免使用漂移的 latest。
API_IMAGE=
# PostgreSQL 数据库需预先存在，表结构由 Prisma 自动创建。
# 示例 postgresql://app_portfolio:URL_ENCODED_PASSWORD@host.docker.internal:5432/app_portfolio
DATABASE_URL=
JWT_SECRET=
ENROLLMENT_DATA_KEY=
JWT_ISSUER=app-portfolio
JWT_AUDIENCE=app-portfolio-api
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:5173,http://localhost:3200
DB_TIMEZONE=Asia/Shanghai
DB_LOGGING=false
RUN_INITIALIZATION=true
# 留空初始化全部模块；多模块以逗号分隔。
SEED_MODULES=
FILE_STORAGE_ENABLED=true
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_STS_TOKEN=
SNAP_AI_URL=
SNAP_AI_KEY=
SNAP_AI_MODEL=
AMAP_REST_KEY=
