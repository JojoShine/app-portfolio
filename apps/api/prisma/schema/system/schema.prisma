/// 平台用户
model User {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username  String     @unique @db.VarChar(50)
  email     String     @unique @db.VarChar(255)
  phone     String?    @db.VarChar(20)
  avatar    String?    @db.VarChar(255)
  status    UserStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status], map: "idx_users_status")
  @@map("users")
}

/// 私有文件元数据，实体文件存储于 MinIO
model File {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filename     String               @db.VarChar(255)
  originalName String               @map("original_name") @db.VarChar(255)
  mimeType     String               @map("mime_type") @db.VarChar(100)
  size         Int
  path         String               @unique @db.VarChar(500)
  fileType     FileType             @default(other) @map("file_type")
  uploadedBy   String?              @map("uploaded_by") @db.VarChar(255)
  isPublic     Boolean              @default(false) @map("is_public")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  materials    EnrollmentMaterial[]

  @@index([fileType], map: "idx_files_file_type")
  @@index([uploadedBy], map: "idx_files_uploaded_by")
  @@index([createdAt], map: "idx_files_created_at")
  @@map("files")
}

/// 应用目录分类
model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  apps      App[]

  @@map("categories")
}

/// H5 应用目录
model App {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  icon        String?   @db.VarChar(100)
  path        String    @unique @db.VarChar(255)
  status      AppStatus @default(developing)
  categoryId  String    @map("category_id") @db.Uuid
  isScenario  Boolean   @default(false) @map("is_scenario")
  sort        Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId], map: "idx_apps_category_id")
  @@index([status], map: "idx_apps_status")
  @@index([sort], map: "idx_apps_sort")
  @@map("apps")
}
