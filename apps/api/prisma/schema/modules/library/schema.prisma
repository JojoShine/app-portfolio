model LibraryBranch {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  address      String
  phone        String
  openingHours String   @map("opening_hours")
  status       String   @default("open")
  facilities   Json
  imagePath    String?  @map("image_path")
  sort         Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  holdings     LibraryHolding[]
  seats        LibrarySeat[]
  events       LibraryEvent[]
  reservations LibraryBookReservation[]

  @@map("library_branches")
}

model LibraryBook {
  id             String   @id @default(uuid()) @db.Uuid
  title          String
  author         String
  publisher      String
  publishedYear  Int      @map("published_year")
  isbn           String   @unique
  category       String
  description    String
  catalogSummary String   @map("catalog_summary")
  coverPath      String?  @map("cover_path")
  localTopic     Boolean  @default(false) @map("local_topic")
  popularity     Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  holdings       LibraryHolding[]
  reservations   LibraryBookReservation[]
  shelfItems     LibraryShelfItem[]
  checkIns       LibraryReadingCheckIn[]

  @@index([category])
  @@index([popularity])
  @@map("library_books")
}

model LibraryHolding {
  id              String @id @default(uuid()) @db.Uuid
  bookId          String @map("book_id") @db.Uuid
  branchId        String @map("branch_id") @db.Uuid
  floor           String
  area            String
  callNumber      String @map("call_number")
  totalCopies     Int    @map("total_copies")
  availableCopies Int    @map("available_copies")
  accessType      String @default("lendable") @map("access_type")
  book            LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  branch          LibraryBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  loans           LibraryLoan[]

  @@unique([bookId, branchId, callNumber])
  @@map("library_holdings")
}

model LibraryReader {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @map("user_id")
  cardNumber String   @unique @map("card_number")
  displayName String  @map("display_name")
  status     String   @default("active")
  validUntil DateTime @map("valid_until") @db.Date
  annualGoal Int      @default(24) @map("annual_goal")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  loans      LibraryLoan[]
  bookReservations LibraryBookReservation[]
  seatReservations LibrarySeatReservation[]
  eventRegistrations LibraryEventRegistration[]
  shelfItems LibraryShelfItem[]
  checkIns LibraryReadingCheckIn[]
  messages LibraryMessage[]

  @@map("library_readers")
}

model LibraryLoan {
  id           String   @id @default(uuid()) @db.Uuid
  readerId     String   @map("reader_id") @db.Uuid
  holdingId    String   @map("holding_id") @db.Uuid
  borrowedAt   DateTime @map("borrowed_at") @db.Timestamptz(3)
  dueAt        DateTime @map("due_at") @db.Timestamptz(3)
  returnedAt   DateTime? @map("returned_at") @db.Timestamptz(3)
  renewalCount Int      @default(0) @map("renewal_count")
  status       String   @default("borrowed")
  reader       LibraryReader @relation(fields: [readerId], references: [id], onDelete: Cascade)
  holding      LibraryHolding @relation(fields: [holdingId], references: [id])

  @@index([readerId, status, dueAt])
  @@map("library_loans")
}

model LibraryBookReservation {
  id             String   @id @default(uuid()) @db.Uuid
  readerId       String   @map("reader_id") @db.Uuid
  bookId         String   @map("book_id") @db.Uuid
  pickupBranchId String   @map("pickup_branch_id") @db.Uuid
  status         String   @default("queued")
  queuePosition  Int?     @map("queue_position")
  readyAt        DateTime? @map("ready_at") @db.Timestamptz(3)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  reader         LibraryReader @relation(fields: [readerId], references: [id], onDelete: Cascade)
  book           LibraryBook @relation(fields: [bookId], references: [id])
  pickupBranch   LibraryBranch @relation(fields: [pickupBranchId], references: [id])

  @@index([readerId, status])
  @@map("library_book_reservations")
}

model LibrarySeat {
  id       String @id @default(uuid()) @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  floor    String
  area     String
  label    String
  type     String @default("standard")
  status   String @default("active")
  branch   LibraryBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  reservations LibrarySeatReservation[]

  @@unique([branchId, label])
  @@map("library_seats")
}

model LibrarySeatReservation {
  id          String   @id @default(uuid()) @db.Uuid
  readerId    String   @map("reader_id") @db.Uuid
  seatId      String   @map("seat_id") @db.Uuid
  startsAt    DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime @map("ends_at") @db.Timestamptz(3)
  status      String   @default("reserved")
  checkInCode String   @map("check_in_code")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  checkedInAt DateTime? @map("checked_in_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  reader      LibraryReader @relation(fields: [readerId], references: [id], onDelete: Cascade)
  seat        LibrarySeat @relation(fields: [seatId], references: [id])

  @@index([seatId, startsAt, endsAt])
  @@index([readerId, startsAt, endsAt])
  @@map("library_seat_reservations")
}

model LibraryEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  branchId             String   @map("branch_id") @db.Uuid
  title                String
  summary              String
  description          String
  category             String
  startsAt             DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime @map("ends_at") @db.Timestamptz(3)
  registrationEndsAt   DateTime @map("registration_ends_at") @db.Timestamptz(3)
  capacity             Int
  ageGroup             String   @map("age_group")
  status               String   @default("published")
  coverPath            String?  @map("cover_path")
  agenda               Json
  notice               String
  branch               LibraryBranch @relation(fields: [branchId], references: [id])
  registrations        LibraryEventRegistration[]

  @@index([startsAt, status])
  @@map("library_events")
}

model LibraryEventRegistration {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  readerId    String   @map("reader_id") @db.Uuid
  status      String   @default("registered")
  checkInCode String   @map("check_in_code")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  checkedInAt DateTime? @map("checked_in_at") @db.Timestamptz(3)
  event       LibraryEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reader      LibraryReader @relation(fields: [readerId], references: [id], onDelete: Cascade)

  @@unique([eventId, readerId])
  @@map("library_event_registrations")
}

model LibraryShelfItem {
  id        String   @id @default(uuid()) @db.Uuid
  readerId  String   @map("reader_id") @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  type      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  reader    LibraryReader @relation(fields: [readerId], references: [id], onDelete: Cascade)
  book      LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([readerId, bookId, type])
  @@map("library_shelf_items")
}

model LibraryReadingCheckIn {
  id          String   @id @default(uuid()) @db.Uuid
  readerId    String   @map("reader_id") @db.Uuid
  bookId      String?  @map("book_id") @db.Uuid
  readingDate DateTime @map("reading_date") @db.Date
  minutes     Int
  note        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  reader      LibraryReader @relation(fields: [readerId], references: [id], onDelete: Cascade)
  book        LibraryBook? @relation(fields: [bookId], references: [id])

  @@index([readerId, readingDate])
  @@map("library_reading_check_ins")
}

model LibraryMessage {
  id         String   @id @default(uuid()) @db.Uuid
  readerId   String   @map("reader_id") @db.Uuid
  type       String
  title      String
  content    String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  priority   String   @default("normal")
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  reader     LibraryReader @relation(fields: [readerId], references: [id], onDelete: Cascade)

  @@index([readerId, readAt, createdAt])
  @@map("library_messages")
}
