NODE_ENV=development
PORT=3000
TRUST_PROXY_HOPS=0

# Local Docker PostgreSQL
DATABASE_URL=postgresql://app_portfolio:app_portfolio_local@127.0.0.1:5433/app_portfolio?schema=public&options=-c%20timezone%3DAsia%2FShanghai

# Optional fallback when DATABASE_URL is not configured
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=app_portfolio
DB_USER=app_portfolio
DB_PASSWORD=app_portfolio_local
DB_LOGGING=false
DB_TIMEZONE=Asia/Shanghai

# Authentication. Replace both values before sharing an environment.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=app-portfolio
JWT_AUDIENCE=app-portfolio-api
JWT_EXPIRES_IN=1h
ENABLE_DEV_AUTH=true
DEV_AUTH_SECRET=replace-local-development-secret

CORS_ORIGINS=http://localhost:5173

# Enrollment sensitive-data encryption. Replace before sharing an environment.
ENROLLMENT_DATA_KEY=replace-with-at-least-32-random-characters

# Local Docker MinIO
FILE_STORAGE_ENABLED=true
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=app_portfolio_minio
MINIO_SECRET_KEY=app_portfolio_minio_local
MINIO_BUCKET=app-portfolio
